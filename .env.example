# Copia este archivo a .env y completa solo lo que vayas a usar. .env NO se sube al repo.

# ---------------- LLM ----------------
# anthropic | bedrock | openai   (openai = cualquier endpoint compatible: OpenAI, Groq, Ollama)
LLM_PROVIDER=anthropic
# Anthropic API: claude-haiku-4-5 · Bedrock: us.anthropic.claude-haiku-4-5-20251001-v1:0
# OpenAI: gpt-4o-mini · Groq: llama-3.3-70b-versatile
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Groq: https://api.groq.com/openai/v1 · Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=
AWS_REGION=us-east-1

# ---------------- Búsqueda ----------------
# mock (sin claves, fixtures locales) | tavily
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# ---------------- Base de datos ----------------
# sqlite | dynamodb
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/leads.db
DYNAMODB_LEADS_TABLE=leads
DYNAMODB_RUNS_TABLE=lead_runs
# DynamoDB Local: http://localhost:8000 (vacío = AWS real)
DYNAMODB_ENDPOINT_URL=

# ---------------- Agente ----------------
AGENT_MAX_STEPS=15
AGENT_MAX_SEARCHES=5

# sync = el agente corre dentro de la petición · async = encola en SQS (producción)
RUN_MODE=sync
RUNS_QUEUE_URL=
LOG_LEVEL=INFO
# text (legible en terminal) | json (CloudWatch Logs Insights)
LOG_FORMAT=text
